cat >> .gitignore << 'EOF'

# Build outputs
/dist/
/build/
/out/
*.exe
*.dll
*.zip
*.tar.gz

# Dependencies
node_modules
/.pnp
.pnp.js
# Ignore node_modules in both frontend and backend
Backend/node_modules/
REP-master/node_modules/



# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# IDE
.vscode/
.idea/

# System
.DS_Store
thumbs.db
EOF